<section class="py-5">
    <div class="container px-4 px-lg-5 mt-5">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3 mb-4">
                <h4 class="mb-3">Categories</h4>
                <div class="list-group">
                    <a href="#" class="list-group-item list-group-item-action">Breads</a>
                    <a href="#" class="list-group-item list-group-item-action">Pastries</a>
                    <a href="#" class="list-group-item list-group-item-action">Pies</a>
                    <a href="#" class="list-group-item list-group-item-action">Cakes</a>
                </div>
            </div>

            <!-- Product grid -->
            <div class="col-lg-9">
                <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">
                    {{#products}}
                        <div class="col mb-5">
                            <div class="card h-100">
                                <!-- Product image -->
                                <img class="card-img-top" src="https://dummyimage.com/450x300/dee2e6/6c757d.jpg" alt="{{name}}" />
                                <!-- Product details -->
                                <div class="card-body p-4">
                                    <div class="text-center">
                                        <h5 class="fw-bolder">{{name}}</h5>
                                        {{price}}
                                    </div>
                                </div>
                                <!-- Product actions -->
                                <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                                    <div class="text-center">
                                        <a class="btn btn-outline-dark mt-auto" href="#">View options</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{/products}}
                </div>
            </div>
        </div>
    </div>
</section>
