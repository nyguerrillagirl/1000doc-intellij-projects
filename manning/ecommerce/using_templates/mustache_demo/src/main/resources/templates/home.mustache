<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>

    <!-- Latest Bootstrap 5.3.x -->
    <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
    >

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        main {
            flex: 1;
        }
    </style>
</head>

<body>
{{> layout/header}}

<main class="flex-fill container mt-4">
    {{#premiumMessage}}
        <div class="alert alert-success">
            Thanks for being a premium member!
        </div>
    {{/premiumMessage}}

    <h2 class="mb-3">Our Products</h2>

    <div class="row">
        {{#products}}
            {{> product}}
        {{/products}}
    </div>
</main>

{{> layout/footer}}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
